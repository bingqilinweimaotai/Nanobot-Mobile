# Copy to /etc/nanobot/relay.env and chmod 600.
# The relay reads these at startup; secrets never appear on the command line.

RELAY_LISTEN=127.0.0.1:8787
RELAY_PUBLIC_URL=wss://relay.example.com/nanobot
RELAY_PATH=/nanobot
RELAY_MODE=shared-key
RELAY_KEY=replace-with-a-random-32-byte-secret
RELAY_TRUST_PROXY=true

RELAY_MAX_STREAMS_PER_HOST=64
RELAY_MAX_CLIENTS_PER_HOST=16
RELAY_HANDSHAKES_PER_MINUTE=60
RELAY_MAX_PREAUTH_PER_IP=20

# Outbound queue and keepalive tuning. 4 MiB absorbs ~170 ms of jitter at a 200 Mbit/s peak;
# queues are allocated on demand. Raise only with the memory budget in mind.
RELAY_SEND_QUEUE_BYTES=4194304
RELAY_SEND_QUEUE_FRAMES=512
RELAY_WRITE_TIMEOUT=30s
RELAY_PING_INTERVAL=25s
RELAY_PONG_TIMEOUT=25s
